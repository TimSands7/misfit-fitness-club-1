---
---

<section id="contact" class="bg-navy py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-10">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
			<div>
				<p class="kicker mb-6">Get Started</p>
				<h2 class="font-display tracking-wide text-heading" style="font-size: clamp(3rem, 7vw, 6rem); line-height: 1;">
					Ready to train<br /><span class="text-brand">like you mean it?</span>
				</h2>
			</div>

			<div>
				<p class="text-lg font-light leading-relaxed text-body">
					Book a free intro session and let's talk about your goals. No commitment, no pressure — just a real conversation about what training at Misfit Fitness Club could look like for you.
				</p>

				<div class="mt-8 flex flex-col gap-4 sm:flex-row">
					<a
						href="tel:+1XXXXXXXXXX"
						class="bg-brand px-8 py-4 text-center font-body font-semibold uppercase tracking-widest text-ink text-sm transition-colors hover:bg-brand-dark"
					>
						Call to Book
					</a>
					<a
						href="mailto:misfitfitnessclub@gmail.com"
						class="border border-border px-8 py-4 text-center font-body font-medium uppercase tracking-widest text-body text-sm transition-colors hover:border-brand hover:text-brand"
					>
						misfitfitnessclub@gmail.com
					</a>
				</div>

				<div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
					{['Denville, NJ', 'By Appointment Only', 'Free Intro Session'].map((item) => (
						<span class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted">
							<span class="h-1 w-4 bg-brand"></span>{item}
						</span>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
